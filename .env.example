# Origin of the Wisper API this app talks to. Drives BOTH the server-side
# `/wisper/*` rewrite (the browser calls same-origin, Next proxies here, so no
# CORS) AND the lease shell console WebSocket, which connects DIRECTLY here.
# It must be NEXT_PUBLIC_ because the browser builds the WS URL and can only read
# public vars. Preserve any path prefix; the client swaps https->wss / http->ws.
# Required on Vercel, which serves the app but CANNOT proxy a WebSocket upgrade
# through Next `rewrites()` (a same-origin shell WS returns 400). Defaults to
# http://localhost:8080 when unset (local `next dev`/`next start` proxies WS fine).
NEXT_PUBLIC_WISPER_API_ORIGIN=https://<wisper-host>

# Stripe publishable key for the billing top-up flow. Public (baked into the
# client bundle) and safe to expose. Without it the wallet still renders, but the
# "Add funds" dialog reports that payments are not configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Cognito user pool used for auth. These are public (baked into the client
# bundle) and are safe to expose; they only identify the pool, not secrets.
# The app builds and runs without them; when UNSET, the login page instead
# offers "Sign in with API key" (paste a wisper-api key defined in the
# operator's Auth:ApiKeys config) — see the README "Local development against
# wisper-api" section. When set, the Cognito flow takes precedence.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<region>_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
