# Base URL of the Wisper API this app proxies to. The browser calls same-origin
# `/wisper/*` and Next rewrites it here (server-side), so there is no CORS.
# Point this at your Wisper host. Defaults to http://localhost:8080 when unset.
WISPER_API_URL=https://<wisper-host>

# Public origin of the Wisper API, used ONLY for the lease shell console
# WebSocket, which connects DIRECTLY here instead of via the same-origin
# `/wisper` rewrite. Required on Vercel: it serves the app but CANNOT proxy a
# WebSocket upgrade through Next `rewrites()`, so a same-origin shell WS returns
# 400. The one-time ticket in the query string is the auth, so a cross-origin WS
# needs no cookie/CORS. Preserve any path prefix (e.g. `/wisper-api-dev`); the
# client swaps https->wss / http->ws. When UNSET, the console falls back to the
# same-origin `/wisper` WS, which works under local `next dev`/`next start`
# (a real Node server proxies WS fine). Only the WS uses this; HTTP stays on the
# same-origin rewrite.
NEXT_PUBLIC_WISPER_API_ORIGIN=https://api.benkile.com/wisper-api-dev

# Stripe publishable key for the billing top-up flow. Public (baked into the
# client bundle) and safe to expose. Without it the wallet still renders, but the
# "Add funds" dialog reports that payments are not configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Cognito user pool used for auth. These are public (baked into the client
# bundle) and are safe to expose; they only identify the pool, not secrets.
# The app builds and runs without them; when UNSET, the login page instead
# offers "Sign in with API key" (paste a wisper-api key defined in the
# operator's Auth:ApiKeys config) — see the README "Local development against
# wisper-api" section. When set, the Cognito flow takes precedence.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<region>_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
