# Base URL of the Wisper API this app proxies to. The browser calls same-origin
# `/wisper/*` and Next rewrites it here (server-side), so there is no CORS.
# Point this at your Wisper host. Defaults to http://localhost:8080 when unset.
WISPER_API_URL=https://<wisper-host>

# Cognito user pool used for auth. These are public (baked into the client
# bundle) and are safe to expose; they only identify the pool, not secrets.
# The app builds and runs without them, but sign-in is disabled until set.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<region>_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
